@model List<ResultPopularLocationDTO>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Popüler Lokasyonlar Listesi</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">Şehir Adı</th>
                                <th scope="col"></th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>
                                        <img src="@item.ImageURL" style="width: 50px; height: 50px; object-fit: cover; border-radius: 50%; margin-right: 10px;" />
                                        @item.CityName
                                    </td>
                                    <td><a href="/Admin/PopularLocation/UpdatePopularLocation/@item.LocationID" class="btn btn-outline-success">Güncelle</a></td>
                                    <td><a href="/Admin/PopularLocation/DeletePopularLocation/@item.LocationID" class="btn btn-outline-danger">Sil</a></td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                    <a href="/Admin/PopularLocation/CreatePopularLocation" class="btn btn-outline-info">Yeni Lokasyon Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>

