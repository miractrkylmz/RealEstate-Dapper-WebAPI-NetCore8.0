@using RealEstate_Dapper_UI.DTOs.ProductDTOs
@model List<ResultProductDTO>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Admin/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">İlan Listesi</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">İlan Başlığı</th>
                                <th scope="col">Şehir</th>
                                <th scope="col">İlçe</th>
                                <th scope="col">Kategori</th>
                                <th scope="col">Fiyat</th>
                                <th scope="col">Tür</th>
                                <th scope="col">Günün Fırsatı</th>
                                <th scope="col"></th>
                                <th scope="col"></th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.title</td>
                                    <td>@item.city</td>
                                    <td>@item.district</td>
                                    <td>@item.categoryName</td>
                                    <td>@item.price</td>
                                    <td>@item.type</td>
                                    <td>@if (item.dealOfTheDay==true)
                                        {
                                            <a href="/Product/ProductChangeDealOfTheDayStatusToFalse/@item.id" class="btn btn-outline-secondary">Pasif Yap</a>
                                        }else{
                                            <a href="/Product/ProductChangeDealOfTheDayStatusToTrue/@item.id" class="btn btn-outline-warning">Aktif Yap</a>
                                        }
                                    </td>
                                    <td><a href="/Admin/Product/ProductDetail/@item.id" class="btn btn-outline-primary">Sitede Gör</a></td>
                                    <td><a href="/Admin/Product/UpdateProduct/@item.id" class="btn btn-outline-success">Güncelle</a></td>
                                    <td>
                                        <a href="/Admin/Product/DeleteProduct/@item.id"
                                           class="btn btn-outline-danger"
                                           onclick="return confirm('Bu ilanı silmek istediğine emin misin?')">
                                            Sil
                                        </a>
                                    </td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                    <a href="/Admin/Product/CreateProduct" class="btn btn-outline-info">Yeni İlan Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>

