@model List<RealEstate_Dapper_UI.DTOs.CategoryDTOs.ResultCategoryDTO>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Default/Views/Shared/_DefaultLayout.cshtml";
}

<section class="w3l-cover-3">
    <div class="cover top-bottom">
        <div class="container">
            <div class="middle-section text-center">
                <div class="section-width">
                    <p>Hayalinizdeki Eve Sahip Olun!</p>
                    <h2>Bugün Sizin İçin Doğru Evi Bulalım!</h2>
                    <div class="most-searches">
                        <h4>Sık Arananlar</h4>
                        <ul>
                            <li><a href="#link">Villa</a></li>
                            <li><a href="#link">Daire</a></li>
                            <li><a href="#link">Yazlık</a></li>
                        </ul>
                    </div>
                    <form asp-area="Default" asp-controller="Default" asp-action="PartialSearch" class="w3l-cover-3-gd" method="post">
                        <input type="search" name="searchKeyValue" placeholder="Anahtar kelimeyi girin" required>
                        <span class="input-group-btn">
                            <select class="btn btn-default" name="propertyCategoryId">
                                <option selected="">Gayrimenkul Türü</option>
                                @foreach (var item in Model)
                                {
                                    <option value="@item.CategoryID">@item.CategoryName</option>
                                }
                            </select>
                        </span>
                        <span class="input-group-btn">
                            <select class="btn btn-default" name="city">
                                <option selected="">Şehir Seçin</option>
                                <option>İstanbul</option>
                                <option>Paris</option>
                                <option>Milano</option>
                                <option>Roma</option>
                                <option>Lyon</option>
                                <option>Münih</option>
                                <option>Berlin</option>
                                <option>Sofya</option>
                            </select>
                        </span>
                        <button type="submit" class="btn-primary">Ara</button>
                    </form>
                </div>
                <section id="bottom" class="demo">
                    <a href="#bottom"><span></span>İlan Listesi</a>
                </section>
            </div>
        </div>
    </div>
</section>

@await Component.InvokeAsync("_ProductListComponentPartial")

@await Component.InvokeAsync("_WhoWeAreComponentPartial")

@await Component.InvokeAsync("_BottomGridComponentPartial")

@await Component.InvokeAsync("_ExploreCitiesComponentPartial")

@await Component.InvokeAsync("_OurClientsComponentPartial")

@await Component.InvokeAsync("_SubFeatureComponentPartial")

@await Component.InvokeAsync("_DiscountOfDayComponentPartial")

@await Component.InvokeAsync("_BrandsComponentPartial")
