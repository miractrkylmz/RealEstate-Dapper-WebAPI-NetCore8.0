<style>
    .property-card {
        border-radius: 15px;
        overflow: hidden;
        transition: transform 0.3s ease-in-out;
    }

        .property-card:hover {
            transform: scale(1.05);
        }

    .property-image {
        height: 250px;
        object-fit: cover;
    }

    .rentext-listing-category {
        top: 10px;
        left: 10px;
    }

        .rentext-listing-category .badge {
            font-size: 0.8rem;
            margin-right: 5px;
        }

    .card-body {
        padding: 1rem;
        text-align: center;
    }
</style>