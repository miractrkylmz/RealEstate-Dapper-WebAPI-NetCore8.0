@model List<RealEstate_Dapper_UI.DTOs.ProductDTOs.ResultProductAdvertListWithCategoryByEmployeeDTO>
@{
    ViewData["Title"] = "ActiveAdverts";
    Layout = "~/Areas/EstateAgent/Views/LayoutEstateAgent/Index.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-12">
            <div class="bg-light rounded h-100 p-4">
                <h6 class="mb-4">Aktif İlan Listesi</h6>
                <div class="table-responsive">
                    <table class="table">
                        <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">İlan Başlığı</th>
                                <th scope="col">Kategori</th>
                                <th scope="col">Fiyat</th>
                                <th scope="col">Tür</th>
                                <th scope="col"></th>
                                <th scope="col"></th>
                                <th scope="col"></th>
                                <th scope="col"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int count = 1;
                            }
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <th scope="row">@count</th>
                                    <td>@item.title</td>
                                    <td>@item.categoryName</td>
                                    <td>@item.price</td>
                                    <td>@item.type</td>
                                    <td><a href="/Product/ProductDetail/@item.id" class="btn btn-outline-primary">Sitede Gör</a></td>
                                    <td><a href="/Product/UpdateProduct/@item.id" class="btn btn-outline-success">Güncelle</a></td>
                                    <td><a href="#/@item.id" class="btn btn-outline-dark">Pasif Yap</a></td>
                                    <td>
                                        <a href="/Product/DeleteProduct/@item.id"
                                           class="btn btn-outline-danger"
                                           onclick="return confirm('Bu ilanı silmek istediğine emin misin?')">
                                            Sil
                                        </a>
                                    </td>
                                </tr>
                                count++;
                            }
                        </tbody>
                    </table>
                    <a href="/EstateAgent/MyAdverts/CreateAdvert" class="btn btn-outline-info">Yeni İlan Girişi</a>
                </div>
            </div>
        </div>
    </div>
</div>


